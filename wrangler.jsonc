{
  // Static-assets-only Worker: no `main` script, so Cloudflare serves the
  // files in ./site directly from its edge. Requests never invoke a Worker
  // and are not billed — there is no origin for a visitor's request to reach.
  //
  // The custom domain (markdown.informededucation.com) is managed in the
  // dashboard and deliberately not declared here: adding a `routes` key would
  // make wrangler authoritative over it and could drop configuration this
  // file does not know about.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "md-viewer",
  "compatibility_date": "2026-09-06",
  // markdown.informededucation.com is the only address this site answers on.
  // Both of these default to enabled, which would serve identical pages at a
  // workers.dev address and at a per-deployment preview URL — duplicate
  // content, and addresses people could bookmark by mistake.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site"
  }
}
